# Real candidate data and private entry points never enter the public repo.
private/

# Machine-local agent preferences (also in .git/info/exclude).
/.local/

# Build and test outputs. Every run writes to a new timestamped folder here.
# The folder itself is tracked through .gitkeep so documented compile
# commands work on a fresh clone.
builds/*
!builds/.gitkeep

# Git worktrees: every extra checkout lives here (docs/git-workflow.md).
/.worktrees/

# Local scratch renders at the repo root.
/*.pdf
/*.png

# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Local scratch renders from earlier sessions. The root exports/ is retired
# (Output Contract, 2026-09-30): a PDF left there shows in git status and
# fails the suite until it is deleted.
previews/

# Night Shift: its working files stay local; the history of nights is committed.
.night-shift/*
!.night-shift/history/
