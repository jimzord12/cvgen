{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jimzord12/cvgen/packages/domains/marine/templates/flagship/schema/flagship-input.schema.json",
  "title": "Flagship template input",
  "description": "What the Flagship template renders: the marine facts (packages/domains/marine/schema/candidate.schema.json, by $ref) plus what Flagship adds, its copy overrides. Holds no facts of its own (ADR 0016); produced by domains/marine/templates/flagship/adapter/adapter.typ.",
  "$ref": "../../../schema/candidate.schema.json",
  "properties": {
    "copy": {
      "type": "object",
      "description": "Overrides for the wording, merged over the domain, role and template defaults composed in adapter.typ; include only the keys you change.",
      "additionalProperties": false,
      "properties": {
        "experience": {
          "type": "string"
        },
        "skills": {
          "type": "string"
        },
        "contract": {
          "type": "string"
        },
        "contracts": {
          "type": "string"
        },
        "experience-subtitle": {
          "type": "string"
        },
        "continuation": {
          "type": "string"
        },
        "combined": {
          "type": "string"
        },
        "total": {
          "type": "string"
        },
        "vessels": {
          "type": "string"
        },
        "companies": {
          "type": "string"
        },
        "vessel": {
          "type": "string",
          "description": "Singular of vessels, used when the total is one."
        },
        "company": {
          "type": "string",
          "description": "Singular of companies, used when the total is one."
        },
        "certificates": {
          "type": "string"
        },
        "certificates-subtitle": {
          "type": "string"
        },
        "certificate-columns": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "description": "Three headings are enough when no certificate has a review.",
          "items": {
            "type": "string"
          }
        },
        "education-languages": {
          "type": "string"
        },
        "education": {
          "type": "string"
        },
        "languages": {
          "type": "string"
        },
        "page-caption": {
          "type": "string"
        },
        "brand": {
          "type": "string"
        }
      }
    }
  }
}
