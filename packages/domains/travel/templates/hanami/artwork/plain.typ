// The plain pack: Hanami essential without Japan, for a client who wants a generic professional page.
// One neutral motif in the band, a route arc from a hollow origin to a ringed destination in the band's
// line colour (assets/plain/route-arc.svg), no sakura, and no Japanese word beside the rank
// (`native-words: false`). Only essential draws with it: showcase's pages need the Japan pack.
#let artwork = (
  route-arc: "/packages/domains/travel/assets/plain/route-arc.svg",
  logo: "/packages/domains/travel/assets/cvgen-wordmark.svg",
  // the band's one motif, by key
  band-motif: "route-arc",
  native-words: false,
)
