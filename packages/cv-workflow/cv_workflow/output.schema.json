{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cvgen.output/1",
  "title": "Meta File: what one PDF is (docs/proposals/output-contract.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "kind", "domain", "candidate", "pages", "date", "status", "sha256"],
  "properties": {
    "contract": {"const": "cvgen.output/1"},
    "kind": {"enum": ["concept", "text-draft", "example", "client-cv", "client-draft"]},
    "domain": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "candidate": {"type": "string", "minLength": 1},
    "alias": {"type": "string", "pattern": "^client-\\d{4}-\\d{2}-\\d{2}(-\\d+)?$"},
    "rank": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "style": {"type": "string", "minLength": 1},
    "idea": {"type": "string", "minLength": 1},
    "density": {"enum": ["condensed", "spacious"]},
    "tier": {"enum": ["safe", "stylish", "creative"]},
    "variant": {"type": "string", "minLength": 1},
    "lang": {"type": "string", "pattern": "^[a-z]{2}$"},
    "pages": {"type": "integer", "minimum": 1},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "status": {"type": "string"},
    "source": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producedBy": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "concept"}}},
     "then": {"required": ["style", "density", "tier"], "properties": {"status": {"enum": ["proposed", "chosen", "parked", "rejected", "unresolved"]}}}},
    {"if": {"properties": {"kind": {"const": "text-draft"}}},
     "then": {"required": ["style"], "properties": {"status": {"enum": ["proposed", "chosen", "parked", "rejected", "unresolved"]}}}},
    {"if": {"properties": {"kind": {"const": "example"}}},
     "then": {"required": ["style", "source"], "properties": {"status": {"const": "release"}}}},
    {"if": {"properties": {"kind": {"const": "client-cv"}}},
     "then": {"required": ["alias"], "properties": {"status": {"enum": ["render", "approved", "delivered"]}}}},
    {"if": {"properties": {"kind": {"const": "client-draft"}}},
     "then": {"required": ["alias"], "properties": {"status": {"enum": ["sent", "signed-off", "superseded"]}}}}
  ]
}
